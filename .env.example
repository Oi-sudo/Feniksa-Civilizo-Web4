# Feniksa Civilizo Web4 · Alpha production environment template
# Copy values into the hosting platform's encrypted environment settings.
# Never commit real secrets.

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Public application URL. Production MUST use https://
APP_URL=https://alpha.example.org

# Authentication / session
SESSION_COOKIE_NAME=feniksa_session
SESSION_DAYS=30
SESSION_SECRET=replace-with-a-long-random-secret

# Transactional email
# External registration must remain disabled until a real mail adapter/provider is configured.
EMAIL_FROM=noreply@example.org

# Runtime
NODE_ENV=production
